{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Fork-owned combat parameter contracts.",
    "definitions": {
        "action": {
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "custom_action": {
                                "const": "TeamManagementAction"
                            }
                        },
                        "required": [
                            "custom_action"
                        ]
                    },
                    "then": {
                        "required": [
                            "custom_action_param"
                        ],
                        "properties": {
                            "custom_action_param": {
                                "type": "object",
                                "properties": {
                                    "mode": {
                                        "enum": [
                                            "recommend",
                                            "plan",
                                            "farm",
                                            "capture"
                                        ]
                                    }
                                },
                                "required": [
                                    "mode"
                                ],
                                "additionalProperties": false
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "custom_action": {
                                "const": "TeamMemberLevelAction"
                            }
                        },
                        "required": [
                            "custom_action"
                        ]
                    },
                    "then": {
                        "required": [
                            "custom_action_param"
                        ],
                        "properties": {
                            "custom_action_param": {
                                "type": "object",
                                "properties": {
                                    "step": {
                                        "enum": [
                                            "init",
                                            "read",
                                            "review",
                                            "verify"
                                        ]
                                    }
                                },
                                "required": [
                                    "step"
                                ],
                                "additionalProperties": false
                            }
                        }
                    }
                }
            ]
        }
    }
}
