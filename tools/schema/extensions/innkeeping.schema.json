{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Fork-owned innkeeping parameter contracts.",
    "definitions": {
        "action": {
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "custom_action": {
                                "const": "InnkeepingReactiveAction"
                            }
                        },
                        "required": [
                            "custom_action"
                        ]
                    },
                    "then": {
                        "properties": {
                            "custom_action_param": {
                                "type": "object",
                                "properties": {
                                    "reset": {
                                        "type": "boolean"
                                    },
                                    "automatic": {
                                        "type": "boolean"
                                    },
                                    "route_id": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "trial_profile": {
                                        "const": "front-row-maatouch-v1"
                                    }
                                },
                                "additionalProperties": false
                            }
                        }
                    }
                },
                {
                    "if": {
                        "required": [
                            "custom_action"
                        ],
                        "properties": {
                            "custom_action": {
                                "const": "InnkeepingAssistAction"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "custom_action_param": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "focus": {
                                        "enum": [
                                            "kitchen"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "recognition": {
            "allOf": [
                {
                    "if": {
                        "required": [
                            "custom_recognition"
                        ],
                        "properties": {
                            "custom_recognition": {
                                "const": "InnkeepingReadyFoodOffset"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "custom_recognition_param"
                        ],
                        "properties": {
                            "custom_recognition_param": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "dish",
                                    "side"
                                ],
                                "properties": {
                                    "dish": {
                                        "enum": [
                                            "hot_sour_soup",
                                            "fin_dumpling",
                                            "tuber_fries",
                                            "salted_cheese_crackers"
                                        ]
                                    },
                                    "side": {
                                        "enum": [
                                            "left",
                                            "right",
                                            "center"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "required": [
                            "custom_recognition"
                        ],
                        "properties": {
                            "custom_recognition": {
                                "const": "InnkeepingPhysicalBoard"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "custom_recognition_param"
                        ],
                        "properties": {
                            "custom_recognition_param": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "number",
                                    "box",
                                    "template"
                                ],
                                "properties": {
                                    "number": {
                                        "enum": [
                                            "1",
                                            "2",
                                            "3",
                                            "4",
                                            "5",
                                            "6"
                                        ]
                                    },
                                    "box": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        },
                                        "minItems": 4,
                                        "maxItems": 4
                                    },
                                    "template": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "required": [
                            "custom_recognition"
                        ],
                        "properties": {
                            "custom_recognition": {
                                "const": "InnkeepingKitchenQueueCount"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "custom_recognition_param"
                        ],
                        "properties": {
                            "custom_recognition_param": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "kitchen",
                                    "count"
                                ],
                                "properties": {
                                    "kitchen": {
                                        "enum": [
                                            "1",
                                            "2"
                                        ]
                                    },
                                    "count": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 3
                                    },
                                    "expected": {
                                        "type": "object",
                                        "additionalProperties": {
                                            "type": "integer",
                                            "minimum": 0,
                                            "maximum": 3
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "type": "object",
                        "required": [
                            "custom_recognition"
                        ],
                        "properties": {
                            "custom_recognition": {
                                "const": "InnkeepingCounterOrigin"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "custom_recognition_param"
                        ],
                        "properties": {
                            "custom_recognition_param": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "reference",
                                    "mode"
                                ],
                                "properties": {
                                    "mode": {
                                        "enum": [
                                            "aligned",
                                            "left_fine",
                                            "right_fine",
                                            "left_coarse",
                                            "right_coarse",
                                            "left_large",
                                            "right_large"
                                        ]
                                    },
                                    "reference": {
                                        "type": "array",
                                        "minItems": 2,
                                        "maxItems": 2,
                                        "items": {
                                            "type": "object",
                                            "required": [
                                                "box",
                                                "pixels"
                                            ],
                                            "properties": {
                                                "box": {
                                                    "type": "array",
                                                    "minItems": 4,
                                                    "maxItems": 4,
                                                    "items": {
                                                        "type": "integer"
                                                    }
                                                },
                                                "pixels": {
                                                    "type": "string"
                                                },
                                                "architecture_only": {
                                                    "type": "boolean"
                                                }
                                            }
                                        }
                                    },
                                    "capture_failure": {
                                        "type": "boolean"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "required": [
                            "custom_recognition"
                        ],
                        "properties": {
                            "custom_recognition": {
                                "const": "InnkeepingTrayContents"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "custom_recognition_param"
                        ],
                        "properties": {
                            "custom_recognition_param": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "expected"
                                ],
                                "properties": {
                                    "expected": {
                                        "type": "object",
                                        "maxProperties": 5,
                                        "additionalProperties": {
                                            "type": "integer",
                                            "minimum": 1,
                                            "maximum": 5
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
