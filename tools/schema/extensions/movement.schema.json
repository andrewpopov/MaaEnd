{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Fork-owned movement parameter contracts.",
    "definitions": {
        "action": {
            "allOf": [
                {
                    "if": {
                        "required": [
                            "custom_action"
                        ],
                        "properties": {
                            "custom_action": {
                                "const": "CharacterControllerJoystickAction"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "custom_action_param"
                        ],
                        "properties": {
                            "custom_action_param": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "direction",
                                    "duration"
                                ],
                                "properties": {
                                    "direction": {
                                        "enum": [
                                            "forward",
                                            "backward",
                                            "left",
                                            "right"
                                        ]
                                    },
                                    "duration": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 1500
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
