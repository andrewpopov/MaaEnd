        "TeamManagementTargets": {
            "type": "input",
            "label": "$option.TeamManagementTargets.label",
            "inputs": [
                {
                    "name": "operator_level",
                    "label": "$option.TeamManagementTargets.operator_level",
                    "default": "90",
                    "pipeline_type": "int",
                    "verify": "^([1-9]|[1-8][0-9]|90)$"
                },
                {
                    "name": "weapon_level",
                    "label": "$option.TeamManagementTargets.weapon_level",
                    "default": "90",
                    "pipeline_type": "int",
                    "verify": "^([1-9]|[1-8][0-9]|90)$"
                },
                {
                    "name": "skill_rank",
                    "label": "$option.TeamManagementTargets.skill_rank",
                    "default": "9",
                    "pipeline_type": "int",
                    "verify": "^[1-9]$"
                },
                {
                    "name": "mastery_rank",
                    "label": "$option.TeamManagementTargets.mastery_rank",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^[0-3]$"
                }
            ],
            "pipeline_override": {
                "TeamManagementSettings": {
                    "attach": {
                        "operator_level": "{operator_level}",
                        "weapon_level": "{weapon_level}",
                        "skill_rank": "{skill_rank}",
                        "mastery_rank": "{mastery_rank}"
                    }
                }
            }
        },
        "TeamManagementMedication": {
            "type": "select",
            "label": "$option.TeamManagementMedication.label",
            "cases": [
                {
                    "name": "EndTask",
                    "label": "$option.AutoUseSpMedication.cases.EndTask.label",
                    "pipeline_override": {
                        "ProtocolSpacePopupSanityLowExit": {
                            "enabled": true
                        },
                        "ProtocolSpacePopupSanityLowUseSpMedicationPrepare": {
                            "enabled": false
                        },
                        "ProtocolSpaceRewardClaimSuccessSanityLowDialog": {
                            "enabled": true
                        },
                        "ProtocolSpaceRewardClaimSuccessSanityLowUseSpMedicationPrepare": {
                            "enabled": false
                        },
                        "ProtocolSpaceRewardClaimRestoreSanityUseMedication": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "UseMedication",
                    "label": "$option.AutoUseSpMedication.cases.UseMedication.label",
                    "option": [
                        "ProtocolSpaceSpMedicationExpireWithinDays"
                    ],
                    "pipeline_override": {
                        "ProtocolSpacePopupSanityLowExit": {
                            "enabled": false
                        },
                        "ProtocolSpacePopupSanityLowUseSpMedicationPrepare": {
                            "enabled": true
                        },
                        "ProtocolSpaceRewardClaimSuccessSanityLowDialog": {
                            "enabled": false
                        },
                        "ProtocolSpaceRewardClaimSuccessSanityLowUseSpMedicationPrepare": {
                            "enabled": true
                        },
                        "ProtocolSpaceRewardClaimRestoreSanityUseMedication": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "EndTask"
        },
        "TeamMemberLevelTarget": {
            "type": "input",
            "label": "$option.TeamMemberLevelTarget.label",
            "inputs": [
                {
                    "name": "operator_name",
                    "label": "$option.TeamMemberLevelTarget.operator_name",
                    "default": "Si",
                    "verify": "^[A-Za-z][A-Za-z :'-]{0,39}$"
                },
                {
                    "name": "operator_level",
                    "label": "$option.TeamMemberLevelTarget.operator_level",
                    "default": "90",
                    "pipeline_type": "int",
                    "verify": "^(8[0-9]|90)$"
                },
                {
                    "name": "currency_budget",
                    "label": "$option.TeamMemberLevelTarget.currency_budget",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(0|[1-9][0-9]{0,8})$"
                }
            ],
            "pipeline_override": {
                "TeamManagementSettings": {
                    "attach": {
                        "operator_name": "{operator_name}",
                        "operator_level": "{operator_level}",
                        "currency_budget": "{currency_budget}"
                    }
                }
            }
        }
